fmt := import("fmt")
map := import("map")
times := import("times")

// active_doors tracks sectors currently moving
active_doors := {}

open_door_stay := func(sec_id) {
	key := string(sec_id)
	if active_doors[key] {
		return
	}
	active_doors[key] = true

	sec := map.get_sector(sec_id)
	if sec == undefined {
		active_doors[key] = false
		return
	}

	dest_ceil := map.get_lowest_adjacent_ceiling(sec_id) - 4

	// Raise door ceiling to (lowest adjacent ceiling - 4)
	for sec.ceiling_height < dest_ceil {
		new_h := sec.ceiling_height + 2
		if new_h > dest_ceil {
			new_h = dest_ceil
		}
		map.set_sector_ceiling_height(sec_id, new_h)
		times.sleep(28 * times.millisecond)
		sec = map.get_sector(sec_id)
	}

	active_doors[key] = false
}

// Line special 103: S1 Open Door Stay Open (Switch 1-Time Open Door Stay)
line_special_103 := func(line_id, sec_id, thing_id, tag) {
	if line_id >= 0 {
		map.set_line_special(line_id, 0)
	}

	if tag != 0 {
		sec_ids := map.find_sectors_by_tag(tag)
		for s in sec_ids {
			open_door_stay(s)
		}
	} else {
		target := sec_id
		line := map.get_line(line_id)
		if line != undefined && line.back_sector >= 0 {
			target = line.back_sector
		}
		if target >= 0 {
			open_door_stay(target)
		}
	}
}

export line_special_103
